#include <winver.h>

// 아이콘 ID 32512(IDI_APPLICATION): webview 라이브러리가 창/작업표시줄 아이콘을
// LoadImage(hInstance, IDI_APPLICATION)으로 찾으므로 이 ID여야 표시된다.
// 탐색기 파일 아이콘은 유일한 그룹 아이콘이므로 그대로 이 아이콘을 쓴다.
32512 ICON "app.ico"
// 매니페스트는 반드시 숫자 타입 24(RT_MANIFEST) — winver.h에는 RT_MANIFEST 매크로가
// 없어 이름을 그대로 쓰면 문자열 타입으로 들어가 Windows가 무시한다.
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     3,0,0,0
PRODUCTVERSION  3,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041204B0"
    BEGIN
      VALUE "CompanyName",      "Personal Wedding Tools"
      VALUE "FileDescription",  "마음장부 카운터"
      VALUE "FileVersion",      "3.0.0"
      VALUE "InternalName",     "MaeumLedgerCounter"
      VALUE "OriginalFilename", "마음장부_카운터_v3.0.0.exe"
      VALUE "ProductName",      "마음장부 카운터"
      VALUE "ProductVersion",   "3.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0412, 1200
  END
END
